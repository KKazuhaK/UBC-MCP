{
  "name": "ubc-mcp",
  "version": "0.1.0-alpha.3",
  "description": "UBC course discovery and registration planning with isolated personal Workday snapshots",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "author": "Kazuha Mo",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "ubc-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "deploy",
    "docs"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:live": "npm run build && node scripts/live-check.mjs",
    "start": "node dist/cli.js",
    "connector": "node dist/connector/cli.js serve",
    "test:protocol": "npm run build && node scripts/protocol-check.mjs",
    "build:extension": "node scripts/build-extension.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "cheerio": "1.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/chrome": "0.3.6",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "linkedom": "0.18.14",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
