UBC_PROFILE=public
# Personal stdio process: each Hub user binds a different READ token.
# UBC_PROFILE=personal
# UBC_CONNECTOR_URL=https://your-connector.example
# UBC_CONNECTOR_TOKEN=
# Local-only alternative for verification; never set this on a shared personal entry.
# UBC_SNAPSHOT_FILE=/absolute/path/to/private/snapshot.json

# Connector administration and local companion upload:
# UBC_DATA_DIR=.data/connector
# UBC_CONNECTOR_HOST=127.0.0.1
# UBC_CONNECTOR_PORT=8792
# UBC_UPLOAD_TOKEN=
