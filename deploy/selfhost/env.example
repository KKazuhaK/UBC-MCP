# Pin the first validated image. Change this digest deliberately when upgrading.
# beta will track releases after the first release built by the image workflow.
UBC_CONNECTOR_IMAGE=ghcr.io/kkazuhak/ubc-connector@sha256:bcfd437b5a549c01a083770e08cda1478ec1f31a299e9773a9c8709bcee8cdd3
# Preserve the actual live mount and UBC_DATA_DIR when migrating. These paths
# are examples for a fresh installation, not proof of your existing layout.
UBC_DATA_PATH=/opt/ubc-connector/data
UBC_DATA_DIR=/data/connector
# Hosted deployment behind an MCPHub: enable the adapter explicitly.
# For a standalone connector (no platform) use UBC_PLATFORM_ADAPTER=none and
# leave UBC_PUBLIC_ORIGIN unset.
# mcphub-oauth is recommended (OAuth 2.1 + PKCE). The cookie-based "mcphub"
# adapter is deprecated and logs a warning at startup.
UBC_PLATFORM_ADAPTER=mcphub-oauth
UBC_PUBLIC_ORIGIN=https://hub.example.com
# mcphub-oauth only (UBC_PLATFORM_URL and the three below are required):
UBC_PLATFORM_URL=https://hub.example.com
UBC_OAUTH_CLIENT_ID=ubc-connector
# Register the client in MCPHub as a PUBLIC client (no secret). Leave the secret
# unset unless your MCPHub supports confidential clients in the authorization code flow.
# UBC_OAUTH_CLIENT_SECRET=
# UBC_PLATFORM_SERVER_NAME=ubc-personal
# At least 32 bytes, for example: openssl rand -base64 48
UBC_SESSION_SECRET=change-me-to-a-long-random-secret-of-32-bytes-or-more
UBC_HUB_NETWORK=mcphub_default
