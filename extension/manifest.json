{
  "manifest_version": 3,
  "name": "UBC Course Capture",
  "version": "0.4.0",
  "description": "Preview and sync your UBC Workday course snapshots to your private connection.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "alarms"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "optional_host_permissions": [
    "https://*/*"
  ]
}
